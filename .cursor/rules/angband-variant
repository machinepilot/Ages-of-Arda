{
  "project": {
    "name": "angband-variant",
    "aiFeatures": {
      "emergentGameplay": true,
      "mcpIntegration": true,
      "multiAgentSystem": true,
      "memoryBankSystem": true,
      "adaptiveUX": true
    },
    "modelPreferences": {
      "default": "codellama:13b",
      "gameplay": "llama2:13b",
      "design": "gpt-4",
      "narrative": "llama2:13b",
      "combat": "codellama:13b",
      "world": "mistral:7b"
    },
    "documentation": {
      "autoAttach": [
        "angband-variant.mdc",
        "c-style.mdc",
        "mcp-integration.mdc",
        "ai-gameplay.mdc",
        "memory-bank.mdc",
        "multi-agent.mdc",
        "mcp-server.mdc",
        "ai-ux.mdc"
      ]
    }
  },
  "features": {
    "copilot": true,
    "contextAwareness": true,
    "semanticHighlighting": true,
    "autoCompletion": true,
    "aiAgents": {
      "enabled": true,
      "agentTypes": [
        "narrative",
        "combat",
        "world",
        "player"
      ]
    },
    "memoryBank": {
      "enabled": true,
      "path": "memory-bank/",
      "autoUpdate": true
    }
  },
  "paths": {
    "exclude": [
      "**/venv/**",
      "**/output/**",
      "**/.git/**"
    ],
    "include": [
      "src/**",
      "memory-bank/**"
    ]
  },
  "ollamaConfig": {
    "endpoints": {
      "local": "http://localhost:11434",
      "modelFallback": [
        "codellama:13b",
        "llama2:13b",
        "mistral:7b"
      ]
    },
    "resourceManagement": {
      "gpuMemory": "auto",
      "batchSize": "auto",
      "quantization": "auto"
    },
    "promptTemplates": {
      "narrative": {
        "template": "[GAME_STATE]\n{game_state}\n[/GAME_STATE]\n[PLAYER_HISTORY]\n{player_history}\n[/PLAYER_HISTORY]\n[INSTRUCTION]\n{instruction}\n[/INSTRUCTION]",
        "temperature": 0.8,
        "maxTokens": 500
      },
      "combat": {
        "template": "[COMBAT_STATE]\n{combat_state}\n[/COMBAT_STATE]\n[INSTRUCTION]\n{instruction}\n[/INSTRUCTION]",
        "temperature": 0.4,
        "maxTokens": 300
      },
      "world": {
        "template": "[WORLD_STATE]\n{world_state}\n[/WORLD_STATE]\n[INSTRUCTION]\n{instruction}\n[/INSTRUCTION]",
        "temperature": 0.6,
        "maxTokens": 400
      }
    }
  },
  "mcpConfig": {
    "servers": [
      {
        "name": "narrative-server",
        "port": 8001,
        "model": "llama2:13b",
        "tools": ["generateDescription", "createDialogue", "developQuest"]
      },
      {
        "name": "combat-server",
        "port": 8002,
        "model": "codellama:13b",
        "tools": ["analyzeCombat", "generateTactics", "balanceDifficulty"]
      },
      {
        "name": "world-server",
        "port": 8003,
        "model": "mistral:7b",
        "tools": ["generateDungeon", "manageFactions", "createEnvironment"]
      }
    ],
    "clientConfig": {
      "timeout": 5000,
      "retryAttempts": 3,
      "cacheResponses": true
    }
  }
} 