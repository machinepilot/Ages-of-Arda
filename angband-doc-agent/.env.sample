# Angband Documentation Agent - Sample Environment Variables
# Copy this file to .env and update the values as needed

# Path to the Angband source code
# Replace with the actual path to your Angband source code
ANGBAND_SOURCE_PATH=C:/path/to/angband

# MCP Server URL
# The URL of the Model Context Protocol server
MCP_SERVER_URL=http://localhost:3000

# Output directory for documentation
# Relative to the project root
OUTPUT_DIR=docs

# Port for the MCP server
# Change if port 3000 is already in use
PORT=3000 